#!/usr/bin/env bash
# 설치: <kit>/install.sh 가 .git/hooks/pre-push 로 링크한다.
# 푸시되는 범위에 대해 게이트(포맷·린트·타입·테스트)와 시크릿 스캔을 돌린다.
# 에이전트 훅과 달리 사람이 손으로 푸시해도, 다른 에이전트를 써도 걸린다.
set -uo pipefail
# 게이트는 대상 레포에 vendor 된 .ai-kit/ 에서 찾는다 — 다른 머신·CI 에서도 동일 경로.
REPO=$(git rev-parse --show-toplevel) || exit 1
KIT="${AI_KIT_DIR:-$REPO/.ai-kit}"
[ -d "$KIT" ] || { echo "$(basename "$0"): .ai-kit 가 없습니다 — install.sh 를 다시 실행하세요" >&2; exit 1; }

ZERO='0000000000000000000000000000000000000000'
fail=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue            # 브랜치 삭제 — 검사 없음
  if [ "$remote_sha" = "$ZERO" ]; then
    base=""                                          # 새 브랜치 → gate 기본(main 기준)
  else
    base="$remote_sha"
  fi

  if [ -n "$base" ]; then
    bash "$KIT/gate/secrets.sh" --range "${base}..${local_sha}" || fail=1
    bash "$KIT/gate/gate.sh" --base "$base" || fail=1
  else
    bash "$KIT/gate/gate.sh" || fail=1
  fi
done

[ $fail -ne 0 ] && { echo "" >&2; echo "pre-push 게이트 실패 — 푸시를 중단합니다." >&2; exit 1; }
exit 0

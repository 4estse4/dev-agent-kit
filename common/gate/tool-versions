# 게이트가 쓰는 도구의 고정 버전. **단일 출처다.**
#
# 이 값을 읽는 곳:
#   .ai-kit/gate/lib.sh          도구가 없을 때 설치 안내에 버전을 넣는다. CI 가 Go 를 까는 go.mod 를 go_min 과 견준다
#   .ai-kit/gate/install-tools.sh 이 버전대로 설치한다
#   .github/workflows/gates.yml         CI 가 이 버전대로 설치한다
#
# 런타임은 여기 없다. **프로젝트가 자기 파일에 적고 CI 가 그것을 읽는다:**
#   go      go.mod 의 go 지시어
#   node    .nvmrc
#   python  .python-version   (`uv python pin 3.12` 이 만든다)
# 킷이 버전을 고르면 프로젝트가 정한 값과 두 벌이 되므로 고르지 않는다.
#
# java 만 예외다 — Gradle 래퍼는 Gradle 을 핀하지 JDK 를 핀하지 않고, 표준 핀 파일이
# 없다. 그래서 워크플로의 AI_KIT_JAVA_VERSION 이 정한다(워크플로는 프로젝트 소유다).
#
# 형식: <이름>=<버전>  (셸이 source 할 수 있게 공백 없이)

# Go 의 최소 버전. 런타임은 위대로 go.mod 가 정하지만, 아래에 핀한 Go 도구가 이보다 낮은
# go 로는 설치되지 않는다. 아래 Go 도구 셋이 각각 요구하는 go(그 모듈의 go 줄) 가운데 가장 높은
# 것이 이 값이고, 패치까지 그대로 적는다 — Go 의 버전 순서로 1.26 < 1.26.0 < 1.26.1 이다
# (go.dev/doc/toolchain). 한때 goimports 와 govulncheck 만 보고 정했다가, 더 높은 go 를 요구하는
# golangci-lint 가 러너에서 「requires go >= …」 로 실패했다(실제로 확인함).
# CI 는 깔 Go(toolchain 줄이 있으면 그 버전, 없으면 go 줄)가 가장 높은 go.mod 로 Go 를 깔고, 그
# 버전이 이보다 낮으면 그 이유를 말하며 멈춘다. go 줄이 1.26 처럼 패치가 없으면 setup-go 가 그
# 계열의 패치 하나를 깔므로 계열끼리 견준다.
# 도구 핀을 올리면 이 값도 본다. 각 도구 모듈의 go 줄은 proxy.golang.org 의 <모듈>/@v/<버전>.mod 에 있다.
go_min=1.26.0

# Go — go install 로 받는다. go.mod 의 tool 지시어를 쓰는 프로젝트는 그쪽이 우선한다.
goimports=v0.50.0
golangci_lint=v2.13.2
govulncheck=v1.8.0

# Python — 독립 바이너리. 프로젝트 의존성과 무관하다.
ruff=0.16.8

# JVM — 독립 실행 바이너리(GitHub 릴리즈).
ktlint=1.8.0

# TypeScript 도구(eslint·prettier·tsc·vitest)는 여기 없다.
# 프로젝트의 package.json + 락파일이 이미 버전을 고정하고, 게이트는 npm run 으로
# 그것을 부른다 — 킷이 따로 핀하면 락파일과 두 벌이 되어 반드시 어긋난다.

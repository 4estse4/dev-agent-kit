#!/usr/bin/env bash
# 활성화: `git config core.hooksPath .ai-kit/git-hooks` (clone 마다 필요하다).
# 푸시되는 범위에 대해 게이트(포맷·린트·타입·테스트)와 시크릿 스캔을 돌리고,
# 브랜치를 올리는 푸시면 요구 추적(trace.sh)도 본다.
# 에이전트 훅과 달리 사람이 손으로 푸시해도, 다른 에이전트를 써도 걸린다.
set -uo pipefail
# 게이트는 대상 레포에 vendor 된 .ai-kit/ 에서 찾는다 — 다른 머신·CI 에서도 동일 경로.
REPO=$(git rev-parse --show-toplevel) || exit 1
KIT="${AI_KIT_DIR:-$REPO/.ai-kit}"
[ -d "$KIT" ] || { echo "$(basename "$0"): .ai-kit 가 없습니다 — install.sh 를 다시 실행하세요" >&2; exit 1; }

ZERO='0000000000000000000000000000000000000000'
fail=0

while read -r local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue            # 브랜치 삭제 — 검사 없음
  secrets_range=""
  if [ "$remote_sha" = "$ZERO" ]; then
    # 새 브랜치의 첫 푸시. 원격에 기준점이 없으므로 기본 브랜치와의 merge-base 를 쓴다.
    # 이 경로를 건너뛰면 표준 워크플로(feature 브랜치 → 첫 푸시)에서 시크릿 스캔이
    # 한 번도 돌지 않는다 — push 된 시크릿은 되돌릴 수 없으므로 여기가 마지막 방어선이다.
    # 기본 브랜치 이름을 열거하지 않는다. 원격이 스스로 말해주고, 그것이 없을 때만
    # 흔한 이름을 시도한다 — 열거만 하면 develop·trunk 인 레포가 매번 폴백으로
    # 떨어져 푸시마다 히스토리 전체를 훑는다.
    base=""
    default_ref=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)
    for ref in ${default_ref:+"$default_ref"} main master develop trunk; do
      git rev-parse --verify -q "$ref" >/dev/null 2>&1 || continue
      base=$(git merge-base "$ref" "$local_sha" 2>/dev/null) && [ -n "$base" ] && break
      base=""
    done
    # **기준점이 자기 자신이면 범위가 빈다.** 기본 브랜치 자신을 처음 푸시할 때가
    # 그렇다 — merge-base(main, main) 은 main 이고 `X..X` 는 아무것도 안 낸다.
    # 히스토리 전체가 한 번에 나가는 가장 위험한 푸시가 무검사로 지나간다(실행해 확인함).
    [ "$base" = "$local_sha" ] && base=""
    if [ -z "$base" ]; then
      # 기준점을 못 구했다(고아 브랜치 등). 조용히 건너뛰지 않는다 —
      # 검사가 고장 났을 때 통과시키는 것이 가장 위험하다.
      echo "pre-push: 시크릿 스캔 기준점을 찾을 수 없습니다(기본 브랜치를 못 찾았거나 이 브랜치가 그것입니다)." >&2
      echo "  시크릿 스캔은 이 브랜치의 전체 히스토리를 봅니다." >&2
      # 리비전 **하나**를 준다. `git log <rev>` 는 도달 가능한 모든 커밋을 보므로
      # 루트 커밋도 들어온다. `루트..HEAD` 로 만들면 **루트 커밋이 범위 밖**이라
      # 그 안의 시크릿을 놓친다 — 고아 브랜치의 첫 커밋에 키를 넣어 실행해 확인했다.
      secrets_range="$local_sha"
      # 게이트(포맷·린트·타입)는 여전히 기준점이 필요하다. 그쪽은 루트를 쓴다.
      base=$(git rev-list --max-parents=0 "$local_sha" | tail -1)
    fi
  else
    base="$remote_sha"
  fi

  [ -n "$secrets_range" ] || secrets_range="${base}..${local_sha}"
  bash "$KIT/gate/secrets.sh" --range "$secrets_range" || fail=1
  bash "$KIT/gate/gate.sh" --base "$base" || fail=1
  # 브랜치를 올리는 푸시일 때만 표시한다. 태그 푸시는 추적표와 상관이 없고,
  # 그것까지 세면 태그 하나 붙이는 데 작업 트리의 WIP 가 발목을 잡는다(실제로 있었던 일).
  case "$local_ref" in refs/heads/*) pushed_code=1 ;; esac
done

# 요구 추적도 여기서 본다. CI 는 이것을 별도 잡으로 돌리는데 훅은 안 돌렸다 —
# 그래서 추적표를 고친 뒤 게이트만 돌리고 푸시하면, **CI 가 빨간 것을 PR 을 연 뒤에야**
# 알게 된다. 실제로 그렇게 한 번 났다: 경로 칸을 가운뎃점으로 이었더니 이 검사가
# 그것을 파일 경로로 읽어 실패했는데, PR 본문에는 그 전에 돌린 통과 출력이 붙어 있었다.
# 범위 인자가 없다 — `trace.sh` 는 SPEC 과 추적표를 **작업 트리에서** 읽는다. 그래서
# 커밋 안 한 변경이 있으면 푸시하는 내용과 다른 것을 볼 수 있다. 그 성질을 아는 채로
# 둔다: 추적표가 깨진 채 푸시되는 것을 막는 것이 목적이고, 그 목적에는 이것으로 충분하다.
#
# 코드를 올리는 푸시에서만 돈다. 브랜치 삭제와 태그 푸시는 추적표와 아무 상관이 없는데,
# 작업 트리를 읽으므로 **푸시와 무관한 WIP 가 삭제를 막는다**(실행해 확인함).
[ "${pushed_code:-0}" = 1 ] && { bash "$KIT/gate/trace.sh" || fail=1; }

[ $fail -ne 0 ] && { echo "" >&2; echo "pre-push 게이트 실패 — 푸시를 중단합니다." >&2; exit 1; }
exit 0

#!/usr/bin/env bash
# 활성화: `git config core.hooksPath .kit/git-hooks` (clone 마다 필요하다).
# 막는 것: (1) 보호 브랜치 직접 커밋  (2) 잘못된 신원  (3) 충돌 마커  (4) 커밋에 안 들어간 게이트 설정  (5) 시크릿  (6) 린트
#
# 주의: `git commit --no-verify` 로 우회 가능하다. 그래서 이 훅은 실수만 막고,
# 일부러 하는 우회까지 막는 것은 CI 와 브랜치 보호다. (docs/process/verification-stages.md 참조)
set -uo pipefail
REPO=$(git rev-parse --show-toplevel) || exit 1
# 시크릿 검사와 게이트는 이 훅이 있는 디렉터리의 부모(킷 디렉터리)에서 부른다 — 설치된 레포에서는 .kit/ 이고, 킷의 테스트가
# 킷의 훅을 실행하면 킷의 common/ 이다. 환경 변수로 받지 않는다. 다른 디렉터리를 가리키면 시크릿 검사와 게이트가 통째로
# 바뀌는데, 그 값은 커밋에도 리뷰에도 남지 않는다. git 이 내는 레포 경로와 견주므로 심볼릭 링크를 푼 경로로 구한다.
KIT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P) || exit 1

PROTECTED="${KIT_PROTECTED_BRANCHES:-main master}"
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

# Claude Code 가 띄운 프로세스(세션의 Bash 도구 · 훅)에는 CLAUDE_CODE_CHILD_SESSION=1 이 있다. 그 안에서는 우회 변수를
# 받지 않는다 — 세션이 스스로 붙여도 묻는 것이 없다. 권한 규칙은 세션이 쓴 명령 문자열에만 맞춰 보므로, 세션이 스크립트
# 파일 안에서 우회 변수를 두면 명령 문자열에 그것이 없어 규칙이 보지 못한다. 보호 브랜치 목록도 기본값을 빼지 못하게 늘
# 더한다. 사람의 터미널에는 CLAUDE_CODE_CHILD_SESSION 이 없어 이전처럼 받는다. 세션이 띄운 screen 같은 데서 그것을
# 물려받은 터미널은 예외라, 메시지에 그 변수 이름을 적는다.
SESSION=0
if [ "${CLAUDE_CODE_CHILD_SESSION:-}" = "1" ]; then
  SESSION=1
  PROTECTED="main master $PROTECTED"
fi

for p in $PROTECTED; do
  if [ "$branch" = "$p" ]; then
    if [ "$SESSION" = 0 ] && [ "${KIT_ALLOW_PROTECTED:-0}" = "1" ]; then
      echo "pre-commit — 보호 브랜치 '$branch' 커밋을 KIT_ALLOW_PROTECTED=1 로 허용" >&2
    elif [ "$SESSION" = 1 ]; then
      cat >&2 <<MSG

'$branch' 는 보호 브랜치입니다 — 직접 커밋할 수 없습니다.

  git switch -c feature/<slug>     # 브랜치를 만들고 다시 커밋

Claude Code 세션 안에서 실행됐습니다(CLAUDE_CODE_CHILD_SESSION=1). 세션 안에서는 KIT_ALLOW_PROTECTED 와
KIT_PROTECTED_BRANCHES 로 보호를 풀지 않습니다. 의도적 예외라면 사람이 세션 밖 터미널에서 커밋합니다.
MSG
      exit 1
    else
      cat >&2 <<MSG

'$branch' 는 보호 브랜치입니다 — 직접 커밋할 수 없습니다.

  git switch -c feature/<slug>     # 브랜치를 만들고 다시 커밋
  KIT_ALLOW_PROTECTED=1 git commit ...   # 의도적 예외 (초기 스캐폴드 등)
MSG
      exit 1
    fi
  fi
done

# ── 신원 검증 ──
# .kit/identity 가 있으면 그 이메일로만 커밋할 수 있다.
# includeIf 설정을 잊거나 새 머신에서 clone 했을 때 잘못된 신원으로
# 커밋이 쌓이는 것을 막는다. 기억에 의존하지 않는다.
idfile="$REPO/.kit/identity"
if [ -f "$idfile" ]; then
  want=$(grep -v '^[[:space:]]*#' "$idfile" | grep -v '^[[:space:]]*$' | head -1 | tr -d '[:space:]')
  have=$(git config user.email 2>/dev/null)
  if [ -n "$want" ] && [ "$want" != "$have" ]; then
    cat >&2 <<MSG

커밋 신원이 이 레포의 기대값과 다릅니다.

  기대: $want
  현재: ${have:-(설정 없음)}

  이 레포에만 지정:  git config user.email "$want"
  또는 ~/.gitconfig 의 includeIf 에 이 레포 경로를 추가하세요.
  기대값을 바꾸려면 .kit/identity 를 수정합니다.
MSG
    exit 1
  fi
fi

# ── 충돌 마커 ──
# 3-way 병합이 실패하면 파일에 마커가 남는다 — `git merge`·`rebase`·`cherry-pick`·
# `stash pop` 이 전부 그렇다. 손으로 해소하다 한 덩어리를 빠뜨리면 마커가 든 채로
# 커밋되고, 설정·훅·워크플로가 알림 없이 망가진다(JSON·YAML 은 파싱부터 실패한다).
#
# 스테이지된 내용만 본다 — 작업트리에 해소 중인 파일이 있어도 커밋 대상이 아니면
# 막지 않는다. 진단 자체가 실패하면 통과시키지 않는다.
# core.quotePath 기본값(true)은 비ASCII 경로를 octal 로 이스케이프해 따옴표째 내보낸다.
# 그 문자열로는 git show 가 실패하고, 2>/dev/null 이 그 오류를 감춰서 "마커 없음" 이 된다 —
# 이 킷의 산출물이 한국어 문서라 정확히 그 자리에서 오류 없이 통과했다.
staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM) || {
  echo "pre-commit: 스테이지 목록을 읽지 못했습니다" >&2; exit 1; }
if [ -n "$staged" ]; then
  bad=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    # 텍스트가 아닌 파일은 건너뛴다.
    git diff --cached --numstat -- "$f" | grep -q '^-' && continue
    # `=======` 는 보지 않는다 — 마크다운 setext 제목 밑줄과 구분되지 않는다.
    # 진짜 충돌에는 항상 세 마커가 다 있으므로, 뒤에 라벨이 붙어 모호하지 않은
    # 두 개만으로 충분하다.
    # 파이프로 받지 않는다. pipefail 아래에서 grep -q 가 첫 매치에서 끝나면 남은 내용을 쓰던
    # git show 가 SIGPIPE 로 종료되고 그것이 결과가 되어 "마커 없음" 이 된다 — 마커가 앞쪽에 있는
    # 큰 package-lock.json 이 그렇게 통과했다(실제로 확인함). `< <(…)` 로 전달하면 git show 의
    # 종료코드가 조건에 들어가지 않는다.
    if grep -qE '^(<<<<<<< |>>>>>>> )' < <(git show ":$f" 2>/dev/null); then
      bad="${bad}  $f"$'\n'
    fi
  done <<< "$staged"
  if [ -n "$bad" ]; then
    cat >&2 <<MSG

병합 충돌 마커가 남은 채로 커밋하려 합니다:

${bad}
  해소한 뒤 다시 스테이지하세요.
MSG
    exit 1
  fi
fi

# ── 커밋에 안 들어간 게이트 설정 ──
# 게이트는 작업 트리의 gate.conf 를 읽는다. 그 파일을 고쳐 두고 커밋에 넣지 않으면 검사는 고친 값으로 줄어드는데 그 값은
# 커밋에 남지 않는다. 그래서 작업 트리의 그 파일이 이 커밋에 들어갈 것(인덱스)과 다르면 막는다 — 고치고 스테이지하지 않은
# 것, 인덱스에서 뺐는데 작업 트리에 남은 것이다. 킷 디렉터리가 이 레포 밖이면(킷의 테스트가 킷의 훅을 실행할 때) 이 레포가
# 커밋할 파일이 아니라 보지 않는다. pre-push 도 같은 것을 푸시하는 커밋(HEAD)과 견준다.
conf_rel="${KIT#"$REPO"/}/gate.conf"
if [ "$conf_rel" != "$KIT/gate.conf" ]; then
  if ! git -C "$REPO" diff --quiet -- "$conf_rel" \
     || { [ -e "$REPO/$conf_rel" ] && ! git -C "$REPO" -c core.quotePath=false ls-files --error-unmatch -- "$conf_rel" >/dev/null 2>&1; }; then
    cat >&2 <<MSG

$conf_rel 에 이 커밋에 들어가지 않는 변경이 있습니다. 게이트는 작업 트리의 이 파일을 읽으므로, 그대로 두면 커밋에 남지
않는 값으로 검사합니다. 커밋에 넣거나(git add) 되돌린 뒤 다시 커밋합니다.
MSG
    exit 1
  fi
fi

bash "$KIT/gate/secrets.sh" || exit 1

# ── 린트 ──
# 커밋은 의미 단위라 수 분~수 시간 작업의 끝에 온다. 거기에 린트 시간을 더해도
# 부담이 작고, 얻는 것이 크다 — 위반을 그 커밋에서 찾아내면 푸시할 때 커밋 여러 개를
# 되짚지 않아도 된다. 테스트·빌드는 여기서 실행되지 않는다(그건 pre-push 가 한다).
bash "$KIT/gate/gate.sh" --lint --staged || exit 1
exit 0

#!/usr/bin/env bash
# 설치: <kit>/install.sh 가 .git/hooks/pre-commit 으로 링크한다.
# 막는 것: (1) 보호 브랜치 직접 커밋  (2) 잘못된 신원  (3) 충돌 마커  (4) 시크릿  (5) 린트
#
# 주의: `git commit --no-verify` 로 우회 가능하다. 그래서 이 훅은 '조기 피드백'이고,
# 진짜 backstop 은 CI + 브랜치 보호다. (core/docs/verification-layers.md 참조)
set -uo pipefail
# 게이트는 대상 레포에 vendor 된 .ai-kit/ 에서 찾는다 — 다른 머신·CI 에서도 동일 경로.
REPO=$(git rev-parse --show-toplevel) || exit 1
KIT="${AI_KIT_DIR:-$REPO/.ai-kit}"
[ -d "$KIT" ] || { echo "$(basename "$0"): .ai-kit 가 없습니다 — install.sh 를 다시 실행하세요" >&2; exit 1; }

PROTECTED="${AI_KIT_PROTECTED_BRANCHES:-main master}"
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

for p in $PROTECTED; do
  if [ "$branch" = "$p" ]; then
    if [ "${AI_KIT_ALLOW_PROTECTED:-0}" = "1" ]; then
      echo "pre-commit — 보호 브랜치 '$branch' 커밋을 AI_KIT_ALLOW_PROTECTED=1 로 허용" >&2
    else
      cat >&2 <<MSG

'$branch' 는 보호 브랜치입니다 — 직접 커밋할 수 없습니다.

  git switch -c feature/<slug>     # 브랜치를 만들고 다시 커밋
  AI_KIT_ALLOW_PROTECTED=1 git commit ...   # 의도적 예외 (초기 스캐폴드 등)
MSG
      exit 1
    fi
  fi
done

# ── 신원 검증 ──
# .ai-kit/identity 가 있으면 그 이메일로만 커밋할 수 있다.
# includeIf 설정을 잊거나 새 머신에서 clone 했을 때 잘못된 신원으로
# 커밋이 쌓이는 것을 막는다. 기억에 의존하지 않는다.
idfile="$REPO/.ai-kit/identity"
if [ -f "$idfile" ]; then
  want=$(grep -v '^[[:space:]]*#' "$idfile" | grep -v '^[[:space:]]*$' | head -1 | tr -d '[:space:]')
  have=$(git config user.email 2>/dev/null)
  if [ -n "$want" ] && [ "$want" != "$have" ]; then
    cat >&2 <<MSG

커밋 신원이 이 레포의 기대값과 다릅니다.

  기대: $want
  현재: ${have:-(설정 없음)}

  이 레포에만 지정:  git config user.email "$want"
  또는 ~/.gitconfig 의 includeIf 에 이 레포 경로를 추가하세요.
  기대값을 바꾸려면 .ai-kit/identity 를 수정합니다.
MSG
    exit 1
  fi
fi

# ── 충돌 마커 ──
# 3-way 병합이 실패하면 파일에 마커가 남는다 — `git merge`·`rebase`·`cherry-pick`·
# `stash pop` 이 전부 그렇다. 손으로 해소하다 한 덩어리를 빠뜨리면 마커가 든 채로
# 커밋되고, 설정·훅·워크플로가 조용히 망가진다(JSON·YAML 은 파싱부터 실패한다).
#
# 스테이지된 내용만 본다 — 작업트리에 해소 중인 파일이 있어도 커밋 대상이 아니면
# 막지 않는다. 진단 자체가 실패하면 통과시키지 않는다(검사가 고장 나면 조용히 통과 금지).
# core.quotePath 기본값(true)은 비ASCII 경로를 octal 로 이스케이프해 따옴표째 내보낸다.
# 그 문자열로는 git show 가 실패하고, 2>/dev/null 이 삼켜서 "마커 없음" 이 된다 —
# 이 킷의 산출물이 한국어 문서라 정확히 그 자리에서 조용히 통과했다.
staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM) || {
  echo "pre-commit: 스테이지 목록을 읽지 못했습니다" >&2; exit 1; }
if [ -n "$staged" ]; then
  bad=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    # 텍스트가 아닌 파일은 건너뛴다.
    git diff --cached --numstat -- "$f" | grep -q '^-' && continue
    # `=======` 는 보지 않는다 — 마크다운 setext 제목 밑줄과 구분되지 않는다.
    # 진짜 충돌에는 항상 세 마커가 다 있으므로, 뒤에 라벨이 붙어 모호하지 않은
    # 두 개만으로 충분하다.
    if git show ":$f" 2>/dev/null | grep -qE '^(<<<<<<< |>>>>>>> )'; then
      bad="${bad}  $f"$'\n'
    fi
  done <<< "$staged"
  if [ -n "$bad" ]; then
    cat >&2 <<MSG

병합 충돌 마커가 남은 채로 커밋하려 합니다:

${bad}
  해소한 뒤 다시 스테이지하세요.
MSG
    exit 1
  fi
fi

bash "$KIT/gate/secrets.sh" || exit 1

# ── 린트 ──
# 커밋은 의미 단위라 수 분~수 시간 작업의 끝에 온다. 거기에 린트 시간을 붙이는 것은
# 감당되고, 얻는 것이 크다 — 위반을 그 커밋에서 잡으면 푸시할 때 커밋 여러 개를
# 되짚지 않아도 된다. 테스트·빌드는 여기서 돌지 않는다(그건 pre-push 가 한다).
bash "$KIT/gate/gate.sh" --lint --staged || exit 1
exit 0
